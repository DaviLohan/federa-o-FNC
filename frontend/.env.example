# ─── API Backend ───────────────────────────────────────────────────────────────
# URL base do backend Django (sem trailing slash)
# Em desenvolvimento local: http://localhost:8000
# No Docker (acessando pelo navegador): http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Ambiente ──────────────────────────────────────────────────────────────────
# Identificador do ambiente (development | production)
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Google OAuth (se usar login social no frontend) ───────────────────────────
# Deve corresponder ao GOOGLE_CLIENT_ID configurado no backend
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
