# ─── Django ────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: gere com `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=django-insecure-change-this-in-production-123456789

# True em desenvolvimento, False em produção
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Settings module (development ou production)
# DJANGO_SETTINGS_MODULE=config.settings.development

# ─── Banco de dados ────────────────────────────────────────────────────────────
# URL de conexão PostgreSQL (usado em produção e no Docker)
DATABASE_URL=postgresql://fnc_user:fnc_password123@localhost:5432/fnc_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Usado para Celery (tasks) e Cache
REDIS_URL=redis://localhost:6379/0

# ─── Email ─────────────────────────────────────────────────────────────────────
# Em desenvolvimento: console.EmailBackend (imprime no terminal)
# Em produção: smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-app-password-do-gmail
DEFAULT_FROM_EMAIL=noreply@fnc.com

# ─── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe (pagamentos internacionais) ────────────────────────────────────────
# Obtenha em: https://dashboard.stripe.com/
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Mercado Pago (pagamentos Brasil) ─────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhooks/mercadopago/
PIX_PAYMENT_EXPIRATION_MINUTES=30
