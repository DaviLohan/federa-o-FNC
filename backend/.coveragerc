[run]
source = .
omit = 
    */venv/*
    */migrations/*
    */tests.py
    */test_*.py
    */__pycache__/*
    */settings.py
    */wsgi.py
    */asgi.py
    manage.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
